{
  "execution": {
    "mode": "full",
    "overwrite": false,
    "continue_after_failure": true,
    "selected_scenario": "controlled_phase1"
  },
  "slm": {
    "provider": "ollama",
    "base_url": "http://localhost:11434",
    "model": "gemma4:e4b",
    "thinking": true,
    "timeout_seconds": 3600,
    "keep_alive": "5m",
    "options": {
      "temperature": 0.2,
      "num_ctx": 131072,
      "top_p": 0.9,
      "seed": 42,
      "num_predict": 131072
    }
  },
  "retry": {
    "max_restart": 3
  },
  "format_repair": {
    "enabled": true,
    "max_attempts": 10,
    "general_prompt_path": "prompts/format_repair/general_repair_prompt.txt"
  },
  "paths": {
    "scenarios_root": "scenarios",
    "output_root": "output",
    "scenario_run_directory_template": "{scenario_name}_{timestamp}",
    "timestamp_format": "%Y-%m-%dT%H-%M-%S",
    "model_slm_directory": "output_model_gen/slm",
    "model_adl_directory": "output_model_gen/adl",
    "artifact_manifest_file": "output_model_gen/artifacts.json",
    "merged_adl_file": "output_model_gen/{scenario_name}_models.adl",
    "intermodel_slm_directory": "output_intermodel/slm",
    "intermodel_aggregate_slm_file": "output_intermodel/intermodel_relations.txt",
    "final_adl_file": "output_intermodel/{scenario_name}_with_intermodel_relations.adl",
    "report_directory": "output/runtime_reports",
    "report_json_filename": "pipeline_{timestamp}.json",
    "report_text_filename": "pipeline_{timestamp}.txt",
    "event_log_filename": "pipeline_{timestamp}.jsonl"
  },
  "files": {
    "scenario_extensions": [
      ".txt"
    ]
  },
  "prompts": {
    "intermodel_template": "prompts/inter_model_generation/inter_model_connections_descriptions/inter_model_gen_connections_template.txt"
  },
  "tools": {
    "python_executable": "",
    "default_python_timeout_seconds": 600,
    "slm_restart": {
      "enabled": true,
      "cwd": ".",
      "timeout_seconds": 120,
      "command": [
        "{python}",
        "scripts/restart_ollama_model.py",
        "--model",
        "{model}",
        "--base-url",
        "{base_url}"
      ]
    },
    "adl_merger": {
      "path": "scripts/adl_model_merger.py",
      "cwd": ".",
      "timeout_seconds": 600,
      "command": [
        "{python}",
        "{merger_path}",
        "{input_files}",
        "--output",
        "{output_adl}"
      ]
    },
    "intermodel_integrator": {
      "path": "scripts/add_intermodel_relations_slm.py",
      "cwd": ".",
      "timeout_seconds": 600,
      "command": [
        "{python}",
        "{integrator_path}",
        "{input_adl}",
        "{relations_slm}",
        "--output",
        "{output_adl}",
        "--overwrite"
      ]
    }
  },
  "models": [
    {
      "id": "GoalModel",
      "enabled": true,
      "scenario_folder": "1GoalModel",
      "display_name": "Goal Model",
      "model_type": "Goal Model",
