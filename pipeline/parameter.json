      "description_path": "prompts/inter_model_generation/model_description/Description_GoalModel.txt",
      "format_prompt_path": "prompts/format_repair/Format_GoalModel.txt",
      "adl_model_name_template": "{scenario_name}_{model_id}_{source_relative_id}",
      "slm_filename_template": "{source_stem}.txt",
      "adl_filename_template": "{source_stem}.adl",
      "converter": {
        "path": "scripts/slm_to_adl/slm_to_adl_GoalModel.py",
        "cwd": ".",
        "timeout_seconds": 600,
        "command": [
          "{python}",
          "{converter_path}",
          "{input_slm}",
          "{output_adl}",
          "--model-name",
          "{adl_model_name}"
